{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "PralayDrishti",
    "Audience": "PralayDrishti.Client",
    "Secret": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "AllowSelfRegistration": true
  },
  "Seed": {
    "DemoUsers": [
      { "Email": "admin@pralaydrishti.local", "Password": "", "Role": "Admin", "FullName": "Demo Admin" },
      { "Email": "analyst@pralaydrishti.local", "Password": "", "Role": "Analyst", "FullName": "Demo Analyst" },
      { "Email": "viewer@pralaydrishti.local", "Password": "", "Role": "Viewer", "FullName": "Demo Viewer" }
    ]
  },
  "Hangfire": {
    "SimulationWorkers": 1,
    "DashboardPath": "/hangfire"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "PralayDrishti": {
    "DataDir": "../../../data",
    "Offline": false,
    "UseOsm": true,
    "OverpassUrl": "https://overpass-api.de/api/interpreter",
    "DefaultDemZoom": 12,
    "CorsOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ],
    "Delft3DCommand": "",
    "LakeWatch": {
      "Enabled": true,
      "AutoSimulate": true
    }
  }
}
