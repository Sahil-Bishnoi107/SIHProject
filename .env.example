# Settings the container reads at runtime. Copy to .env for `docker run --env-file .env ...`.
# Never commit a real .env - it is in .gitignore.

# Postgres (required). Either a URL (Render / Neon / Supabase style) ...
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/pralaydrishti?sslmode=require
# ... or the .NET key/value form:
# ConnectionStrings__DefaultConnection=Host=HOST;Port=5432;Database=pralaydrishti;Username=USER;Password=PASSWORD;SSL Mode=Require

# Redis (optional - without it jobs run in-process and do not survive a restart)
REDIS_URL=redis://HOST:6379

# Signs login tokens. Must be at least 32 characters; generate one with:
#   openssl rand -base64 48
Jwt__Secret=CHANGE_ME_TO_A_LONG_RANDOM_STRING_OF_AT_LEAST_32_CHARS

# Demo accounts on the login page (leave empty to not create them)
Seed__DemoUsers__0__Password=Demo@12345
Seed__DemoUsers__1__Password=Demo@12345
Seed__DemoUsers__2__Password=Demo@12345

# Set to true only when running behind a platform proxy (Render, Railway, Fly...)
ForwardedHeaders__TrustAllProxies=false
